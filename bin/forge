def cmd_help(args):
    """forge help [command]: what a command does and when to use it; no argument lists them."""
    if args and args[0] in HELP: print(HELP[args[0]]); return
    if args: die(f"no help for '{args[0]}'; commands: {', '.join(sorted(HELP))}")
    print(__doc__.rstrip()); print("\nforge help <command> for the long form. CHEATSHEET.md is the workflow by situation; README.md is the why.")

CMDS = {k[4:]: v for k, v in globals().items() if k.startswith("cmd_")}
if __name__ == "__main__":
    if len(sys.argv) >= 2 and sys.argv[1] in ("-h", "--help"): sys.argv[1] = "help"
    if len(sys.argv) >= 3 and sys.argv[2] in ("-h", "--help") and sys.argv[1] in HELP: print(HELP[sys.argv[1]]); sys.exit(0)
    if len(sys.argv) < 2 or sys.argv[1] not in CMDS: print(__doc__); sys.exit(1)
    try: CMDS[sys.argv[1]](sys.argv[2:])
    except RuntimeError as e: die(str(e))
